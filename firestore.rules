rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Default-deny catch-all safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // 2. Health & connection check document
    match /test/connection {
      allow read: if true;
    }

    // 3. Hardened Primitives
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // 4. Schema Validators
    function isValidUser(data) {
      return data.keys().hasAll(['id', 'phone', 'referralCode', 'balanceKES', 'vipLevel']) &&
        data.id is string && data.id.size() <= 128 &&
        data.phone is string && data.phone.size() <= 32 &&
        data.referralCode is string && data.referralCode.size() <= 32 &&
        data.balanceKES is number && data.balanceKES >= 0 &&
        data.vipLevel is number && data.vipLevel >= 0 &&
        (!('avatarUrl' in data) || (data.avatarUrl is string && data.avatarUrl.size() <= 500)) &&
        (!('rechargeBalanceKES' in data) || data.rechargeBalanceKES is number);
    }

    function isValidInvestment(data) {
      return data.keys().hasAll(['id', 'userId', 'planId', 'investedAmount', 'dailyIncome', 'status']) &&
        data.id is string && data.id.size() <= 128 &&
        data.userId is string && data.userId.size() <= 128 &&
        data.planId is string && data.planId.size() <= 64 &&
        data.investedAmount is number && data.investedAmount > 0 &&
        data.dailyIncome is number && data.dailyIncome >= 0 &&
        data.status in ['running', 'completed'];
    }

    function isValidTransaction(data) {
      return data.keys().hasAll(['id', 'userId', 'type', 'amount', 'status', 'reference']) &&
        data.id is string && data.id.size() <= 128 &&
        data.userId is string && data.userId.size() <= 128 &&
        data.type in ['deposit', 'withdrawal', 'investment', 'daily_income', 'referral_bonus', 'mission_reward'] &&
        data.amount is number && data.amount > 0 &&
        data.status in ['completed', 'pending', 'processing'] &&
        data.reference is string && data.reference.size() <= 128 &&
        (!('details' in data) || (data.details is string && data.details.size() <= 500));
    }

    function isValidMpesaRecord(data) {
      return data.keys().hasAll(['id', 'phoneNumber', 'amount', 'status']) &&
        data.id is string && data.id.size() <= 128 &&
        data.phoneNumber is string && data.phoneNumber.size() <= 32 &&
        data.amount is number && data.amount > 0 &&
        data.status is string && data.status.size() <= 32;
    }

    // 5. User Profiles
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow create: if isOwner(userId) && isValidId(userId) && isValidUser(incoming());
      allow update: if isOwner(userId) && isValidId(userId) && isValidUser(incoming());
    }

    // 6. Investments
    match /investments/{investmentId} {
      allow get: if isSignedIn() && existing().userId == request.auth.uid;
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && isValidId(investmentId) && incoming().userId == request.auth.uid && isValidInvestment(incoming());
      allow update: if isSignedIn() && isValidId(investmentId) && existing().userId == request.auth.uid && incoming().userId == existing().userId && isValidInvestment(incoming());
    }

    // 7. Transactions
    match /transactions/{transactionId} {
      allow get: if isSignedIn() && existing().userId == request.auth.uid;
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && isValidId(transactionId) && incoming().userId == request.auth.uid && isValidTransaction(incoming());
    }

    // 8. M-Pesa STK Push Audit Records
    match /mpesa_records/{recordId} {
      allow get, list: if isSignedIn();
      allow create: if isSignedIn() && isValidId(recordId) && isValidMpesaRecord(incoming());
    }
  }
}
